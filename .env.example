# Choose at least one hosted LLM provider for real evaluation.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional deterministic no-key demo mode. Do not use this for benchmark claims.
A2_RAG_OFFLINE=0

# Optional: override embedding cache location.
A2_RAG_EMBED_CACHE=.cache/embeddings_cache.json

# Local embeddings fail closed by default. Enabling this may send corpus text
# to a configured cloud embedding provider when the local model fails.
A2_RAG_ALLOW_EMBEDDING_FAILOVER=0

# Recommended before exposing the Streamlit demo beyond localhost.
A2_RAG_ACCESS_TOKEN=
A2_RAG_MIN_REQUEST_INTERVAL_SECONDS=1.0
